class Solution:
    def longestPalindrome(self, s: str) -> str:
        maxPalindrome = ''
        maxCount = 0;
        for i in range(len(s)):
            l, r = i, i
            #odd
            while(l >= 0 and r < len(s) and s[l] == s[r]):
                if(r - l + 1 > maxCount):
                    maxCount = r - l +1;
                    maxPalindrome = s[l:r+1];
                l = l - 1;
                r = r + 1;
            #even
            l, r = i, i + 1
            while(l >= 0 and r < len(s) and s[l] == s[r]):
                if(r - l + 1 > maxCount):
                    maxCount = r - l + 1;
                    maxPalindrome = s[l:r+1];
                l = l - 1;
                r = r + 1;
        return maxPalindrome;